# Provider keys are SERVER-ONLY. Do not prefix with VITE_ — Vite inlines any
# VITE_*-prefixed variable into the public client bundle, which would ship the
# key to every visitor. The Node server (server/index.mjs) reads the names
# below from process.env.
#
# Set these in your shell (or in pwa/.env, which is gitignored) before running
# `npm run server`. Never paste real keys into chat, PR descriptions, or
# screenshots.

NVIDIA_VISION_API_KEY=your-nvidia-vision-api-key-here
NVIDIA_API_KEY=your-nvidia-general-api-key-here

# Not wired yet — reserved for the speech-recognition path.
NVIDIA_PARAKEET_API_KEY=your-nvidia-parakeet-api-key-here

# ----------------------------------------------------------------------
# Server hardening (server/index.mjs reads these from the process env;
# set them in your shell before running `npm run server`).
# ----------------------------------------------------------------------

# Comma-separated list of origins allowed to call /api/*. The server 403s
# any request whose Origin header is not in this list. Defaults cover
# Vite dev (5173) and preview (4173). Set this to your deployed origin
# in production, e.g. https://isvisible.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional shared secret. If set, /api/* requires the header
#   Authorization: Bearer <this-value>
# Leave unset in local dev. REQUIRED for any publicly reachable deploy —
# without it, anyone who finds the URL can burn your NVIDIA quota.
API_TOKEN=

# How long the server waits for NVIDIA before aborting (milliseconds).
UPSTREAM_TIMEOUT_MS=30000

# Set to "1" only when the server runs behind a reverse proxy you trust
# (nginx, Cloudflare, Render, etc.) so X-Forwarded-For is honored for
# rate-limit IP attribution. Otherwise leave unset — a malicious client
# could spoof X-Forwarded-For to bypass per-IP limits.
# TRUST_PROXY=1

