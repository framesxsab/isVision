# Provider keys are SERVER-ONLY. Do not prefix with VITE_ — Vite inlines any
# VITE_*-prefixed variable into the public client bundle, which would ship the
# key to every visitor. The Node server (server/index.mjs) reads the names
# below from process.env.
#
# Set these in your shell (or in pwa/.env, which is gitignored) before running
# `npm run server`. Never paste real keys into chat, PR descriptions, or
# screenshots.

NVIDIA_VISION_API_KEY=your-nvidia-vision-api-key-here
NVIDIA_API_KEY=your-nvidia-general-api-key-here

# Not wired yet — reserved for the speech-recognition path.
NVIDIA_PARAKEET_API_KEY=your-nvidia-parakeet-api-key-here
