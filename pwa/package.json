{
  "name": "isvisible",
  "private": true,
  "version": "0.1.0",
  "description": "Accessibility platform for blind and visually impaired users",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-liblouis-assets.mjs",
    "dev": "vite",
    "check-env": "node scripts/check-env-leakage.mjs",
    "copy-liblouis": "node scripts/copy-liblouis-assets.mjs",
    "prebuild": "npm run check-env && npm run copy-liblouis",
    "build": "tsc -b && node scripts/vite-build.mjs",
    "prepreview": "node scripts/copy-liblouis-assets.mjs",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "audit:mobile": "node scripts/mobile-audit.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "liblouis": "^0.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "6.30.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4"
  }
}
